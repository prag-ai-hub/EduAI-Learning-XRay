# systemd unit for the Django service.
#
#   sudo cp deploy/eduai-backend.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now eduai-backend
#
# There is no worker or beat unit: this service runs no background queue. Email
# is sent inline on transaction.on_commit (apps/tenants/schools/notifications.py).

[Unit]
Description=EduAI Learning X-Ray - Django API
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=eduai
Group=eduai
WorkingDirectory=/srv/eduai/backend
EnvironmentFile=/srv/eduai/backend/.env
Environment=DJANGO_SETTINGS_MODULE=eduai_backend.settings.prod
ExecStart=/srv/eduai/backend/.venv/bin/gunicorn -c gunicorn.conf.py eduai_backend.wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5

# The process needs no write access outside its own runtime and log directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/eduai/backend/logs /srv/eduai/backend/staticfiles

[Install]
WantedBy=multi-user.target
