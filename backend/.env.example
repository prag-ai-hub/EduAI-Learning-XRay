# Copy to backend/.env and fill in. backend/.env is gitignored.
# This file is the Django service ONLY. The Next.js frontend and the local
# Supabase stack read the repo-root .env - the two are deliberately separate.

# --- Django ---------------------------------------------------------------

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_DEBUG=True
DJANGO_LOG_LEVEL=INFO

# Comma-separated. Required in production; no wildcard fallback exists.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database: the EXISTING Supabase Postgres. No data migration. ---------
# Local stack:  postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Hosted:       the Supabase project's connection string (session pooler).
DATABASE_URL=

# Django's own bookkeeping tables (django_migrations, auth_*, content types)
# are created in this schema so they never mix with the application schema
# that ../supabase/migrations owns. Run scripts/bootstrap_schema.sql once.
DJANGO_DB_SCHEMA=django

# --- Supabase auth bridge -------------------------------------------------
# Supabase remains the identity provider. Django only verifies its tokens.

SUPABASE_URL=

# Project Settings -> API -> JWT Settings -> JWT Secret.
# For the local stack, `npx supabase status` prints it.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# --- CORS: the Cloudflare-hosted frontend origin(s) only ------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Payment gateway (server-side only, never shipped to the browser) -----
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_KEY_SECRET=
PAYMENT_GATEWAY_WEBHOOK_SECRET=

# --- OpenAI proxy ---------------------------------------------------------
# Read server-side only and never returned in any API response.
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Cache ----------------------------------------------------------------
# Shared cache for throttle counters. Without it Django falls back to a
# per-process cache, which makes every rate limit N times looser under N
# gunicorn workers. Optional in dev, expected in production.
REDIS_URL=

# --- Email (registration / suspension notifications) ----------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@eduai.local
