# ===========================  Backend Environment Variables  ===========================
#
# Copy to backend/.env and fill in. backend/.env is gitignored.
#
# This file is the Django service ONLY. The Next.js app and the local Supabase
# stack read the repo-root .env; the two are deliberately separate, and the
# provider keys below exist on this side alone.


# Django Settings
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_LOG_LEVEL=INFO

# Origins allowed to call this API from a browser, and to submit unsafe
# methods. List every tunnel host you actually use - a wildcard here is the
# same as no CORS policy at all.
CORS_ALLOW_CREDENTIALS=False
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# Database Settings (PostgreSQL)
# The EXISTING Supabase-hosted database. No data migration: this service
# connects to the same Postgres the Next.js app already uses.
#   Local stack : DB_HOST=127.0.0.1  DB_PORT=54322  DB_SSLMODE=
#   Hosted      : the project's session-pooler host, DB_SSLMODE=require
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=54322
DB_SSLMODE=

# Django's own bookkeeping tables (django_migrations, auth_*, content types)
# are created in this schema so they never mix with the application tables that
# ../supabase/migrations owns. Run scripts/bootstrap_schema.sql once per database.
DB_SCHEMA=django
DB_CONN_MAX_AGE=60


# Service URLs
# Where this API answers, and where the web app lives. Used to build absolute
# links in outbound email - a relative link in an email goes nowhere.
API_BASE_URL=http://localhost:8000/api/v1
FRONTEND_URL=http://localhost:3000


# Supabase Auth Bridge
# Supabase remains the identity provider. Django only verifies its tokens; it
# does not issue them, and public.users.id references auth.users.id, so it
# cannot create an identity either.
SUPABASE_URL=
# Project Settings -> API -> JWT Settings -> JWT Secret.
# For the local stack, `npx supabase status` prints it.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated


# AI Providers
# This service is the only place these live. Read server-side only, never
# returned in any API response, and never sent to the browser. The frontend
# reaches them through /api/v1/ai/* and holds no provider credential.
OPENAI_API_KEY=
# The model every completion uses. Callers cannot name one - that would make
# the proxy an open tap on this account. /api/v1/ai/health verifies the value
# actually exists for the key above.
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# OCR for scanned answer sheets.
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_OCR_MODEL=mistral-ocr-latest


# Payment Gateway
# Server-side only. Sandbox and live keys are separated by environment and are
# never exposed to the client.
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_KEY_SECRET=
PAYMENT_GATEWAY_WEBHOOK_SECRET=


# Email SMTP
# Registration and suspension notifications.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=support@eduaihub.in


# Google OAuth
# The single declaration for this pair. Django does not consume them - Supabase
# Auth is the identity provider and owns the OAuth dance - but they live here so
# one file holds every credential the project uses.
#
# Locally, `make db-start` exports these so supabase/config.toml can read them
# via env(...). In production they are configured in the Supabase dashboard and
# these stay empty.
#
# Authorised redirect URI to register with Google:
#   http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=


# Cache
# Shared cache for throttle counters. Without one Django falls back to a
# per-process cache, which makes every rate limit N times looser under N
# gunicorn workers. Optional in dev, expected in production.
REDIS_URL=
