# =============================  app/ Environment Variables  ============================
#
# Copy to app/.env. Expo reads EXPO_PUBLIC_* at build time.
#
# This file has TWO HALVES and the difference is not cosmetic.
#
#   EXPO_PUBLIC_*   compiled into the app bundle. Anyone who downloads the APK
#                   can read them. Never a secret, ever.
#   everything else read only by the server runtime - the twenty Expo Router
#                   routes under src/app/api/. Never reaches a client bundle.
#
# Moving a name across that line is the mistake this layout exists to prevent,
# and backend/tests/test_secrets_audit.py fails the build if you do.
#
# Provider keys (OpenAI, Mistral) are in NEITHER half. The Django service holds
# those and the app reaches them through /api/v1/ai/*.


# This app's own server routes (Expo Router /api/*)
# On web these are same-origin, so this can stay empty. On a NATIVE build there
# is no origin to be relative to: without this, every /api/* call fails with
# "No API origin for this build". Set it to the deployed host (the EAS Hosting
# URL in production). This is NOT the Django service below.
EXPO_PUBLIC_API_ORIGIN=


# Analysis Service (Django)
# The app calls this directly with the Supabase access token as a bearer token,
# so this origin must appear in the backend's CORS_ALLOWED_ORIGINS.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000


# Supabase
# The publishable (anon) key only. It is public by design and constrained by
# RLS. The service-role key must never appear in a mobile build.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=


# Google Sign-In
#
# A client ID is public by design - it is in every OAuth redirect URL, and
# Google's own docs say so. A client SECRET is not, and there is no version of
# `EXPO_PUBLIC_GOOGLE_CLIENT_SECRET` that is safe: the prefix means "compile
# this into the bundle", so anyone who downloads the APK reads it with
# `strings`. The mobile OAuth flow is PKCE precisely so a public client does
# not need one. backend/tests/test_secrets_audit.py fails the build on any
# EXPO_PUBLIC_* name that promises a secret, so this cannot be added by mistake.
#
# The exchange that DOES need the secret happens in Supabase Auth, which is the
# identity provider; the pair is configured in the Supabase dashboard (or in
# backend/.env for the local stack) and never reaches a client.

# What @react-native-google-signin passes as webClientId, and what the backend
# verifies id_tokens against. Required on every platform, including Android.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# iOS needs its own client id; Android does NOT - Google matches the Android
# client by package name and signing certificate, so a value here would be
# ignored. Left declared and empty so nobody goes looking for where it went.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Where Google sends the browser back. Public - it appears in the authorisation
# URL. For the local Supabase stack this is
# http://127.0.0.1:54321/auth/v1/callback; in production it is the project's
# own callback, not this app's scheme.
EXPO_PUBLIC_GOOGLE_REDIRECT_URI=


# =======================================================================================
#  SERVER-SIDE ONLY - never prefixed, never bundled
#
#  Read by src/app/api/**+api.ts and the modules in src/server/. These exist
#  because app/ is not a pure client: app.json sets "web": {"output": "server"},
#  so this workspace runs a server of its own. It is the same set frontend/
#  reads today, which app/ inherits when it replaces it.
# =======================================================================================

# Supabase, server side. The secret key has full database access and bypasses
# RLS - it is the most powerful credential this workspace holds.
# SUPABASE_SERVICE_ROLE_KEY is accepted as an alias.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Served to the browser by /api/auth/config rather than compiled in, so rotating
# it does not need a rebuild. SUPABASE_ANON_KEY is accepted as an alias.
SUPABASE_PUBLISHABLE_KEY=

# The Django service, called server-to-server by src/server/ai-proxy.ts.
# Without it, grading, OCR and generation report themselves unavailable rather
# than falling back to a local provider key - there is no local key to fall back to.
DJANGO_API_URL=http://localhost:8000

# HMAC key for parent share links (src/server/share-tokens.ts). REQUIRED: the
# route throws without it rather than signing.
#
# It used to fall back to SUPABASE_SECRET_KEY. That put link-signing and full
# database access behind one value, so a leaked share secret was a leaked
# database. Generate a dedicated one:
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Rotating it invalidates every outstanding share link. Links live 1-90 days
# (30 by default), so the blast radius is bounded by that window.
SHARE_TOKEN_SECRET=

# Credits charged per analysis run. Defaults to 1.
ANALYSIS_CREDIT_COST=1
