# ===========================  Frontend Environment Variables  ==========================
#
# Copy to .env and fill in. .env is gitignored.
#
# This file serves the Next.js app AND the local Supabase stack (supabase/config.toml
# reads it via env(...)). frontend/.env is a symlink to this file so the Vite dev
# server and the Supabase CLI read one copy.
#
# The Django service has its own, separate: see backend/.env.example. Provider
# keys and the database password live there, not here.
#
# For local testing, `make db-start` (npx supabase start) prints the Supabase values.


# Supabase
# Required. The app will not boot without these.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Server-side key. Full database access - never expose to the browser.
# SUPABASE_SERVICE_ROLE_KEY is accepted as an alias.
# Also the HMAC signing key for parent share links (frontend/app/api/shares).
SUPABASE_SECRET_KEY=

# Browser-side key, served to the client by /api/auth/config.
# SUPABASE_ANON_KEY is accepted as an alias.
# Public by design and constrained by RLS - this is the ONLY value here that
# reaches a browser, and it is served at runtime rather than compiled into the
# bundle, so rotating it does not need a rebuild.
# Without it the app returns 503 at startup: "Teacher authentication is not configured."
SUPABASE_PUBLISHABLE_KEY=


# Analysis Service (Django)
# Base URL of the Django REST API, served to the browser by /api/auth/config.
# The browser calls it directly with the Supabase access token, so this origin
# must appear in the backend's CORS_ALLOWED_ORIGINS.
#
# Leave empty until the service is deployed: the client then reports the new
# surfaces as unavailable rather than guessing a host to send bearer tokens to.
API_BASE_URL=http://localhost:8000
DJANGO_API_URL=http://localhost:8000


# AI Providers
# Not here. OPENAI_API_KEY and MISTRAL_API_KEY live in backend/.env; the Django
# service holds them and performs the calls, and this app sends prompts through
# /api/v1/ai/*. One place to rotate, one place to rate limit, and nothing to
# leak from the web tier.
#
# Consequence worth knowing: grading, OCR and generation need DJANGO_API_URL
# above to point at a running service. Without it those features report
# themselves unavailable rather than falling back to a local key.


# Google OAuth
# Not here. The pair now lives in backend/.env as the single declaration, and
# `make db-start` exports it so supabase/config.toml can read it locally. In
# production it is configured in the Supabase dashboard.
#
# The values previously committed here (commit a6d0b38) have been scrubbed from
# git history, but they existed in plaintext on disk and in the source zip -
# ROTATE THAT PAIR in the Google console.


# Optional
# Credits charged per analysis run. Defaults to 1.
ANALYSIS_CREDIT_COST=1
