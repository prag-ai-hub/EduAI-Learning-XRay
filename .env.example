# Copy to .env and fill in. .env is gitignored.
#
# THIS FILE IS THE FRONTEND + LOCAL SUPABASE STACK ONLY.
# The Django service has its own, separate: see backend/.env.example.
# frontend/.env is a symlink to this file, so the Next.js dev server and the
# Supabase CLI read one copy.
#
# For local testing, `make db-start` (npx supabase start) prints the three
# Supabase values.

# --- Supabase: required. The app will not boot without these. ---------------

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Server-side key. Full database access - never expose to the browser.
# SUPABASE_SERVICE_ROLE_KEY is accepted as an alias.
# Also used as the HMAC signing key for parent share links
# (frontend/app/api/shares).
SUPABASE_SECRET_KEY=

# Browser-side key, served to the client by /api/auth/config.
# SUPABASE_ANON_KEY is accepted as an alias.
# Without this the app returns 503 at startup: "Teacher authentication is not configured."
SUPABASE_PUBLISHABLE_KEY=

# --- Django service --------------------------------------------------------
# Base URL of the Django REST API, served to the browser by /api/auth/config.
# The browser calls it directly with the Supabase access token, so this origin
# must appear in Django's CORS_ALLOWED_ORIGINS. Leave empty until the service
# is deployed - the client then reports the new surfaces as unavailable rather
# than guessing a host to send bearer tokens to.
DJANGO_API_URL=http://localhost:8000

# --- AI providers ----------------------------------------------------------

# OCR for scanned answer sheets and PDFs (mistral-ocr-latest).
# Not needed for text/docx/xlsx uploads, which are parsed locally.
MISTRAL_API_KEY=

# Grading, learning-gap diagnosis, study guides, worksheets, assessment generation.
OPENAI_API_KEY=

# --- Optional --------------------------------------------------------------

# Credits charged per analysis run. Defaults to 1.
ANALYSIS_CREDIT_COST=1

# --- Google OAuth ----------------------------------------------------------
# Local only: read by supabase/config.toml via env(...). In production these are
# configured in the Supabase dashboard, not here.
# Authorised redirect URI to register with Google: http://127.0.0.1:54321/auth/v1/callback
#
# These were previously committed here with real values (commit a6d0b38). The
# live pair is in the gitignored .env; ROTATE IT - redacting the file does not
# remove it from git history.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Model used by all AI routes. Verified by /api/system-health.
# The Django proxy reads its own OPENAI_MODEL from backend/.env.
# The committed default "gpt-5.6-sol" is not a published OpenAI model - set this.
OPENAI_MODEL=

# --- Not here ---------------------------------------------------------------
# DATABASE_URL, SUPABASE_JWT_SECRET, DJANGO_SECRET_KEY and the payment gateway
# keys belong to the Django service and live in backend/.env. Keeping them out
# of this file keeps the frontend's runtime surface free of credentials it has
# no reason to hold.
