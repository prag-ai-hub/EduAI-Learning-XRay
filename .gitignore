# ---------------------------------------------------------------------------
# Monorepo: app/ (Expo) + backend/ (Django) + supabase/ (shared schema)
# Patterns are intentionally unanchored so they apply inside both workspaces.
# ---------------------------------------------------------------------------

# --- Secrets. Never commit a filled-in env file. ---------------------------
.env
.env.*
!.env.example
*.pem
*.key

# Credential files with no `.env` in the name, which the rules above would
# otherwise miss. backend/tests/test_secrets_audit.py asserts each of these is
# actually matched, so a rule that stops applying is a failing test.
.envrc
*service-account*.json
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.pfx

# --- Node / Next.js / Cloudflare (frontend/) -------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.next/
.vinext/
out/
dist/
.wrangler/
next-env.d.ts
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel

# --- Expo / React Native (app/) -----------------------------------------
.expo/
expo-env.d.ts
*.jks
*.p8
*.p12
*.mobileprovision
*.orig.*
web-build/

# --- Python / Django (backend/) --------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
.coverage.*
staticfiles/
media/

# --- Testing / coverage ----------------------------------------------------
coverage/

# --- OS / editor -----------------------------------------------------------
.DS_Store
.idea/
*.swp

# --- Local scratch ---------------------------------------------------------
outputs/
work/
.migrations-held/

# Redundant source snapshot (superseded by git history)
EduAI-Learning-X-Ray-source-*.zip

# --- Runtime logs (backend/logs/) ------------------------------------------
logs/*.log
